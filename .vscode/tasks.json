{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "mkpoem",
            "detail": "start a new poem in today's folder",
            "command": "pwsh",
            "type": "process",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/Tools/commands/mkpoem.ps1"],
            "presentation": { "reveal": "never", "close": true },
            "problemMatcher": []
        },
        {
            "label": "serve",
            "detail": "open docs/ at http://localhost:5500, starting the docs server if nothing serves it",
            "command": "pwsh",
            "type": "process",
            "args": ["-NoProfile", "-File", "${workspaceFolder}/Tools/commands/serve.ps1"],
            "presentation": { "reveal": "silent", "close": true },
            "problemMatcher": []
        },
        {
            "label": "review server",
            "detail": "rating editor for the manual review pass; build -r also starts it, hidden",
            "command": "dotnet",
            "type": "process",
            "args": ["run", "--file", "${workspaceFolder}/Tools/review-server.cs"],
            "isBackground": true,
            "presentation": { "reveal": "always", "panel": "dedicated" },
            "problemMatcher": []
        },
        {
            "label": "build",
            "command": "dotnet",
            "type": "process",
            "args": [
                "build",
                "${workspaceFolder}/Poems.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "publish",
            "command": "dotnet",
            "type": "process",
            "args": [
                "publish",
                "${workspaceFolder}/Poems.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        },
        {
            "label": "watch",
            "command": "dotnet",
            "type": "process",
            "args": [
                "watch",
                "run",
                "${workspaceFolder}/Poems.csproj",
                "/property:GenerateFullPaths=true",
                "/consoleloggerparameters:NoSummary"
            ],
            "problemMatcher": "$msCompile"
        }
    ]
}